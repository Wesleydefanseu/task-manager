datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  password      String
  name          String
  memberships   ProjectMember[]
  taskAssignees TaskAssignee[]
  notifications Notification[]
  createdAt     DateTime        @default(now())
}

model Project {
  id              String           @id @default(uuid())
  name            String
  description     String?
  members         ProjectMember[]
  tasks           Task[]
  automationRules AutomationRule[]
  createdAt       DateTime         @default(now())
}

model ProjectMember {
  id        String   @id @default(uuid())
  role      String   @default("MEMBER") // ADMIN | MEMBER
  userId    String
  projectId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
}

model Task {
  id           String         @id @default(uuid())
  title        String
  description  String?
  status       String         @default("TODO")   // TODO | IN_PROGRESS | DONE
  priority     String         @default("MEDIUM") // LOW | MEDIUM | HIGH
  startDate    DateTime?
  dueDate      DateTime?
  duration     Int?
  projectId    String
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignees    TaskAssignee[]
  dependencies Task[]         @relation("TaskDependencies")
  dependents   Task[]         @relation("TaskDependencies")
  createdAt    DateTime       @default(now())
}

model TaskAssignee {
  id     String @id @default(uuid())
  taskId String
  userId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
}

model AutomationRule {
  id           String   @id @default(uuid())
  name         String
  triggerType  String   // STATUS_CHANGE | DUE_DATE_NEAR | TASK_ASSIGNED
  triggerValue String?  // ex: "DONE", "24h", userId
  actionType   String   // CHANGE_PRIORITY | CHANGE_STATUS | ASSIGN_USER | SEND_NOTIFICATION
  actionValue  String?  // ex: "HIGH", "EXPIRED", userId, message text

  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  link      String?  // lien optionnel vers la tâche/projet
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
